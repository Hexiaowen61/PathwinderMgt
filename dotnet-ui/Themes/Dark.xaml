<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题调色板：键名与 Light.xaml 完全一致，切换时整份字典被替换 -->

    <SolidColorBrush x:Key="WindowBg" Color="#1B1C1F"/>
    <SolidColorBrush x:Key="Surface" Color="#26282C"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#2E3035"/>
    <SolidColorBrush x:Key="Border" Color="#383B41"/>
    <SolidColorBrush x:Key="BorderInput" Color="#4A4D53"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#6B7079"/>
    <SolidColorBrush x:Key="Divider" Color="#33363B"/>
    <SolidColorBrush x:Key="HoverBg" Color="#35383D"/>
    <SolidColorBrush x:Key="HoverSoft" Color="#34373C"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED"/>
    <SolidColorBrush x:Key="TextBody" Color="#D7DADE"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C2C6CC"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9BA1A9"/>
    <SolidColorBrush x:Key="TextFaint" Color="#858B94"/>

    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2F6FDF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="DangerHover" Color="#C43B40"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#7F3B3F"/>
    <SolidColorBrush x:Key="Success" Color="#34D399"/>

    <SolidColorBrush x:Key="StatusOkBg" Color="#1E3A2A"/>
    <SolidColorBrush x:Key="StatusOkFg" Color="#7BD88F"/>
    <SolidColorBrush x:Key="StatusWarnBg" Color="#3A3320"/>
    <SolidColorBrush x:Key="StatusWarnFg" Color="#E7C46B"/>
    <SolidColorBrush x:Key="StatusErrorBg" Color="#3B2325"/>
    <SolidColorBrush x:Key="StatusErrorFg" Color="#F08A8A"/>
    <SolidColorBrush x:Key="StatusIdleBg" Color="#33363B"/>
    <SolidColorBrush x:Key="StatusIdleFg" Color="#A9AEB6"/>

    <SolidColorBrush x:Key="RowHover" Color="#2E3035"/>
    <SolidColorBrush x:Key="RowSelected" Color="#2A3450"/>
</ResourceDictionary>
