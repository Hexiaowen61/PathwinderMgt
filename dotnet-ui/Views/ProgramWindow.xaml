<Window x:Class="PathwinderMgt.Views.ProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_Prog_Title}" Height="680" Width="900" MinWidth="900" MinHeight="680"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBody}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource L_Prog_Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <!-- 拷贝：复制当前记录为新记录（显示名/目标路径自动编号），详情页切换到新记录 -->
                <Button Grid.Column="1" Style="{StaticResource ToolbarBtn}" Content="{DynamicResource L_Prog_Copy}"
                        VerticalAlignment="Center" Click="BtnCopy_Click"/>
            </Grid>
        </Border>

        <!-- 基本信息 -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,12" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L_Prog_Name}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtName" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,8" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource L_Prog_Id}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Name="TxtId" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" FontFamily="Consolas" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L_Prog_Arch}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,8">
                    <ComboBox Name="CmbArch" Width="150" Style="{StaticResource ComboBoxBox}" SelectionChanged="CmbArch_SelectionChanged"/>
                    <TextBlock Name="TxtArchWarn" Text="{DynamicResource L_Prog_ArchWarn}"
                               Foreground="{DynamicResource Danger}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- 模式切换：立即重写工作区 Pathwinder.ini 生效；Simple=严格，SimplePro=读回退（默认），Overlay=合并目录视图，自定义=逐规则独立设置 -->
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource L_Prog_Mode}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="1" Grid.Column="3" Name="CmbMode" Width="220"
                          Style="{StaticResource ComboBoxBox}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" Margin="0,0,0,8"
                          SelectionChanged="CmbMode_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource L_Prog_ModeSimple}"/>
                    <ComboBoxItem Content="{DynamicResource L_Prog_ModeSimplePro}"/>
                    <ComboBoxItem Content="{DynamicResource L_Prog_ModeOverlay}"/>
                    <ComboBoxItem Content="{DynamicResource L_Prog_ModeCustom}"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L_Prog_Target}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtTarget" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,20,8" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource L_Prog_Shortcut}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Name="TxtShortcut" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                <!-- 指令内容：已添加指令时显示快捷方式的完整参数（文档 5.2.2）。用只读 TextBox 以便鼠标选中复制 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource L_Prog_Command}" VerticalAlignment="Top" Margin="0,1,8,8"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Name="TxtInstruction" VerticalAlignment="Top"
                         Foreground="{DynamicResource TextMuted}" FontFamily="Consolas" Margin="0,0,0,8"
                         TextWrapping="Wrap" Text="{DynamicResource L_Prog_NoCommand}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="Transparent"
                         BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Disabled"/>

                <!-- Hookshot 诊断日志开关（默认关闭，LogLevel=0；开启后经快捷方式启动会在桌面生成日志，管理器自动清理并补子进程授权） -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource L_Prog_HookshotLog}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Name="ChkHookshotLog"
                          Content="{DynamicResource L_Prog_HookshotLogContent}"
                          VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                          Checked="ChkHookshotLog_Changed" Unchecked="ChkHookshotLog_Changed"/>

                <!-- 标记为不管理：主列表仅保留详情按钮，批量操作（全部添加/全部移除/删除全部记录）自动跳过 -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource L_Prog_ManageMark}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Name="ChkExcluded"
                          Content="{DynamicResource L_Prog_ManageMarkContent}"
                          VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                          Checked="ChkExcluded_Changed" Unchecked="ChkExcluded_Changed"/>
            </Grid>
        </Border>

        <!-- 规则编辑面板（登记时自动带入默认规则，可编辑）：贴边铺满，去掉四周 16px 外边距 -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}">
            <ContentControl Name="PanelHost"/>
        </Border>

        <!-- 底部操作 -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource PrimaryBtn}" Name="BtnApply" Content="{DynamicResource L_Prog_Apply}" Click="BtnApply_Click"/>
                    <Button Style="{StaticResource PrimaryBtn}" Name="BtnUpdate" Content="{DynamicResource L_Prog_Update}" Click="BtnUpdate_Click" Visibility="Collapsed"/>
                    <Button Style="{StaticResource ToolbarBtn}" Name="BtnRemove" Content="{DynamicResource L_Prog_Remove}" Click="BtnRemove_Click"/>
                    <Button Style="{StaticResource ToolbarBtn}" Name="BtnLaunch" Content="{DynamicResource L_Prog_Launch}" Click="BtnLaunch_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DangerRowBtn}" Name="BtnDelete" Content="{DynamicResource L_Prog_Delete}" Click="BtnDelete_Click"/>
                    <Button Style="{StaticResource ToolbarBtn}" Content="{DynamicResource L_Common_Close}" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
