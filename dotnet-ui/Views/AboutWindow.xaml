<Window x:Class="PathwinderMgt.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PathwinderMgt.Views"
    Title="{DynamicResource L_About_Title}" Height="520" Width="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="{DynamicResource WindowBg}"
    FontFamily="Microsoft YaHei" FontSize="13">

    <Window.Resources>
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverSoft}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{DynamicResource L_About_ClickToCopy}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 内容区域（窗口标题栏已显示应用名与版本，页面内不再重复大标题） -->
        <ScrollViewer Grid.Row="0" Padding="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 介绍 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_About_About}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                        <!-- 联系方式按钮：首次启动满 3 天后才显示 -->
                        <WrapPanel local:DelayedReveal.MinDays="3">
                            <Button Style="{StaticResource ChipBtn}" Click="CopyChip_Click"
                                Tag="393135223">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="QQ 393135223" />
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="CopyChip_Click"
                                Tag="301802646">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource L_About_Group}" />
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="CopyChip_Click"
                                Tag="Hexiaowen">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource L_About_Coolapk}" />
                            </Button>
                        </WrapPanel>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" LineHeight="20" Margin="0,6,0,0">
                            <Hyperlink NavigateUri="https://gitee.com/Hexiaowen61"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="{DynamicResource Accent}" TextDecorations="Underline">
                                gitee
                            </Hyperlink>
                            <Run Text="{DynamicResource L_About_Homepage}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" LineHeight="20" Margin="0,4,0,0">
                            <Hyperlink NavigateUri="https://www.bilibili.com/video/BV1vinm61E3e?vd_source=980a22801471db3a0b2614e3feadcb7b"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="{DynamicResource Accent}" TextDecorations="Underline">
                                bilibili
                            </Hyperlink>
                            <Run Text="{DynamicResource L_About_Video}" />
                        </TextBlock>

                        <!-- 下载地址 -->
                        <TextBlock Foreground="{DynamicResource TextSecondary}" LineHeight="20" Margin="0,10,0,0">
                            <Hyperlink NavigateUri="https://github.com/Hexiaowen61/PathwinderMgt/releases"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="{DynamicResource Accent}" TextDecorations="Underline">
                                <Run Text="{DynamicResource L_About_Releases}" />
                            </Hyperlink>
                            <Run Text=" — GitHub Releases" />
                        </TextBlock>
                        <!-- 分享 / 日志 / 检查更新 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Name="ShareButton" Content="{DynamicResource L_About_Share}" Click="ShareButton_Click"
                                Style="{StaticResource ToolbarBtn}" />
                            <Button Content="{DynamicResource L_About_OpenLogs}" Click="BtnOpenLogs_Click"
                                Style="{StaticResource ToolbarBtn}" />
                            <Button Name="BtnCheckUpdate" Content="{DynamicResource L_About_CheckUpdate}" Click="CheckUpdate_Click"
                                Style="{StaticResource ToolbarBtn}" />
                        </StackPanel>
                        <ProgressBar Name="CheckUpdateProgress" Height="3" IsIndeterminate="True"
                            Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"
                            Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <!-- 应用介绍 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_About_Intro}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Text="{DynamicResource L_About_Intro1}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="{DynamicResource L_About_Intro2}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="{DynamicResource L_About_Intro3}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="{DynamicResource L_About_Intro4}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="{DynamicResource L_About_Intro5}" />
                    </StackPanel>
                </Border>

                <!-- 使用注意事项 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_About_Notes}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Text="{DynamicResource L_About_Note1}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,4,0,0" Text="{DynamicResource L_About_Note2}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="18,2,0,0" Text="{DynamicResource L_About_Note2a}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="18,2,0,0" Text="{DynamicResource L_About_Note2b}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,8,0,0"
                            Text="{DynamicResource L_About_Note3}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="{DynamicResource L_About_Note4}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="{DynamicResource L_About_Note5}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="{DynamicResource L_About_Note6}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="{DynamicResource L_About_Note7}" />
                    </StackPanel>
                </Border>

                <!-- 开源地址 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                      CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_About_OpenSource}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock Foreground="{DynamicResource TextSecondary}" LineHeight="20">
                            <Hyperlink NavigateUri="https://github.com/Hexiaowen61/PathwinderMgt/"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="{DynamicResource Accent}" TextDecorations="Underline">
                                PathwinderMgt
                            </Hyperlink>
                            <Run Text="{DynamicResource L_About_RepoGui}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" LineHeight="20" Margin="0,6,0,0">
                            <Hyperlink NavigateUri="https://github.com/samuelgr/Hookshot"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="{DynamicResource Accent}" TextDecorations="Underline">
                                Hookshot
                            </Hyperlink>
                            <Run Text="{DynamicResource L_About_RepoInject}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" LineHeight="20" Margin="0,6,0,0">
                            <Hyperlink NavigateUri="https://github.com/samuelgr/Pathwinder"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="{DynamicResource Accent}" TextDecorations="Underline">
                                Pathwinder
                            </Hyperlink>
                            <Run Text="{DynamicResource L_About_RepoRedirect}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" LineHeight="18"
                            Margin="0,10,0,0" FontSize="12"
                            Text="{DynamicResource L_About_Thanks}" />
                    </StackPanel>
                </Border>

                <!-- 更新记录（读取 resources\changelog.txt，放在界面最末尾） -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_About_Changelog}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="4" Padding="10">
                            <FlowDocumentScrollViewer Name="TxtChangelog" Height="300"
                                IsToolBarVisible="False"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
            HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Name="OkButton" Content="{DynamicResource L_Common_Ok}" Click="OkButton_Click"
                Style="{StaticResource PrimaryBtn}" />
        </StackPanel>
    </Grid>
</Window>