<Window x:Class="PathwinderMgt.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PathwinderMgt.Views"
    Title="关于 Pathwinder 管理器" Height="520" Width="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="#F5F6F8"
    FontFamily="Microsoft YaHei" FontSize="13">

    <Window.Resources>
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击复制" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 内容区域（窗口标题栏已显示应用名与版本，页面内不再重复大标题） -->
        <ScrollViewer Grid.Row="0" Padding="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 介绍 -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold"
                            Foreground="#111827" Margin="0,0,0,10" />
                        <!-- 联系方式按钮：首次启动满 3 天后才显示 -->
                        <WrapPanel local:DelayedReveal.MinDays="3">
                            <Button Style="{StaticResource ChipBtn}" Click="CopyChip_Click"
                                Tag="393135223">
                                <TextBlock FontSize="12" Foreground="#374151" Text="QQ 393135223" />
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="CopyChip_Click"
                                Tag="301802646">
                                <TextBlock FontSize="12" Foreground="#374151" Text="群 301802646" />
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="CopyChip_Click"
                                Tag="Hexiaowen">
                                <TextBlock FontSize="12" Foreground="#374151" Text="酷安 Hexiaowen" />
                            </Button>
                        </WrapPanel>
                        <TextBlock Foreground="#374151" LineHeight="20" Margin="0,6,0,0">
                            <Hyperlink NavigateUri="https://gitee.com/Hexiaowen61"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="#2563EB" TextDecorations="Underline">
                                gitee
                            </Hyperlink>
                            <Run Text=" — 个人主页" />
                        </TextBlock>
                        <TextBlock Foreground="#374151" LineHeight="20" Margin="0,4,0,0">
                            <Hyperlink NavigateUri="https://www.bilibili.com/video/BV1vinm61E3e?vd_source=980a22801471db3a0b2614e3feadcb7b"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="#2563EB" TextDecorations="Underline">
                                bilibili
                            </Hyperlink>
                            <Run Text=" — 视频教学" />
                        </TextBlock>

                        <!-- 下载地址 + 检查更新 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#374151" LineHeight="20" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://github.com/Hexiaowen61/PathwinderMgt/releases"
                                    RequestNavigate="Link_RequestNavigate"
                                    Foreground="#2563EB" TextDecorations="Underline">
                                    下载地址
                                </Hyperlink>
                                <Run Text=" — GitHub Releases" />
                            </TextBlock>
                            <Button Grid.Column="1" Name="BtnCheckUpdate" Content="检查更新"
                                Style="{StaticResource ToolbarBtn}" Margin="0"
                                Click="CheckUpdate_Click" />
                        </Grid>
                        <ProgressBar Name="CheckUpdateProgress" Height="3" IsIndeterminate="True"
                            Foreground="#2563EB" Background="Transparent" BorderThickness="0"
                            Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <!-- 应用介绍 -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="应用介绍" FontSize="14" FontWeight="SemiBold"
                            Foreground="#111827" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Text="Pathwinder 管理器是一款 Windows 桌面工具，让你通过可视化界面，为任意已安装程序添加文件路径重定向能力——无需修改程序代码，即可改变程序的文件读写路径。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="举个例子：大多数程序会在 “C:\Users\用户名\AppData” 下创建数据文件，而本工具能将这些文件重定向到指定目录，且不影响程序正常运行。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="简单来说，如果程序在某个目录（如 “C:\ddd\eee\fff”）下创建了数据文件，而你不想让这些文件写进该目录，就可以用本工具把它们重定向到别处。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="担心涉及的文件夹太多？你可以添加多条重定向规则，或直接指定一个上层目录（如 “C:\ddd”）一并覆盖。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="拖入程序的快捷方式（.lnk）或可执行文件（.exe），配置重定向规则后，一键改写快捷方式，让目标程序在启动时自动应用路径重定向规则。" />
                    </StackPanel>
                </Border>

                <!-- 使用注意事项 -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="使用注意事项" FontSize="14" FontWeight="SemiBold"
                            Foreground="#111827" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Text="• 许多程序在安装时会默认把程序文件装进用户目录（典型路径 “C:\Users\用户名\AppData\Local\Programs”）。这会让本工具内置的“C:\Users”重定向规则与程序启动路径重叠冲突，导致程序启动失败。凡是安装在 “C:\Users” 下的程序，都需要手动配置重定向规则才能正常启动。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,4,0,0" Text="解决办法：" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="18,2,0,0" Text="1. 手动把程序复制到非 “C:\Users” 目录。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="18,2,0,0" Text="2. 在重定向规则中移除 “C:\Users” 目录，改为手动定义重定向规则。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,8,0,0"
                            Text="• 加载器只能拉起新进程，目标程序必须先关闭，再通过受管快捷方式冷启动。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="• 盘符根目录（如 C:\）不能作为重定向规则的起点或目标。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="• 若目标程序需要管理员权限运行，受管快捷方式也需以管理员身份运行，否则注入失败。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="• 修改规则后即时写入工作区配置；已运行的程序需重启后按新规则重定向。" />
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                            Margin="0,6,0,0"
                            Text="• 请勿将本工具安装到需要管理员权限的目录（如 Program Files），推荐安装到用户目录或 D 盘。" />
                    </StackPanel>
                </Border>

                <!-- 开源地址 -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                      CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="开源地址" FontSize="14" FontWeight="SemiBold"
                            Foreground="#111827" Margin="0,0,0,8" />
                        <TextBlock Foreground="#374151" LineHeight="20">
                            <Hyperlink NavigateUri="https://github.com/Hexiaowen61/PathwinderMgt/"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="#2563EB" TextDecorations="Underline">
                                PathwinderMgt
                            </Hyperlink>
                            <Run Text=" — 本项目（图形界面与管理器）" />
                        </TextBlock>
                        <TextBlock Foreground="#374151" LineHeight="20" Margin="0,6,0,0">
                            <Hyperlink NavigateUri="https://github.com/samuelgr/Hookshot"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="#2563EB" TextDecorations="Underline">
                                Hookshot
                            </Hyperlink>
                            <Run Text=" — 通用 DLL 注入与函数调用拦截库" />
                        </TextBlock>
                        <TextBlock Foreground="#374151" LineHeight="20" Margin="0,6,0,0">
                            <Hyperlink NavigateUri="https://github.com/samuelgr/Pathwinder"
                                RequestNavigate="Link_RequestNavigate"
                                Foreground="#2563EB" TextDecorations="Underline">
                                Pathwinder
                            </Hyperlink>
                            <Run Text=" — 文件、目录及注册表路径重定向" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="#6B7280" LineHeight="18"
                            Margin="0,10,0,0" FontSize="12">
                            本工具基于 .NET 8 + WPF 开发，集成上述两个开源项目，感谢开源作者的贡献，欢迎关注。
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 更新记录（读取 resources\changelog.txt，放在界面最末尾） -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="更新记录" FontSize="14" FontWeight="SemiBold"
                            Foreground="#111827" Margin="0,0,0,8" />
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="4" Padding="10">
                            <FlowDocumentScrollViewer Name="TxtChangelog" Height="300"
                                IsToolBarVisible="False"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
            HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Name="ShareButton" Content="分享" Click="ShareButton_Click"
                Style="{StaticResource ToolbarBtn}" />
            <Button Name="OkButton" Content="确定" Click="OkButton_Click"
                Style="{StaticResource PrimaryBtn}" />
        </StackPanel>
    </Grid>
</Window>