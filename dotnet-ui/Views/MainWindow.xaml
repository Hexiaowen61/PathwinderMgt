<Window x:Class="PathwinderMgt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_Main_Title}" Height="680" Width="1000" MinWidth="1000" MinHeight="680"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBg}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_Main_Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource L_Main_Subtitle}"
                               Foreground="{DynamicResource TextMuted}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarBtn}" Content="{DynamicResource L_Main_Admin}" Click="BtnRunAsAdmin_Click" x:Name="BtnRunAsAdmin"/>
                    <Button Style="{StaticResource ToolbarBtn}" Content="{DynamicResource L_Main_About}" Click="BtnAbout_Click"/>
                    <Button Style="{StaticResource ToolbarBtn}" Content="{DynamicResource L_Main_Settings}" Click="BtnSettings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Style="{StaticResource ToolbarBtn}" Click="BtnRefresh_Click"
                    Padding="8,6" ToolTip="{DynamicResource L_Main_Refresh}" AutomationProperties.Name="{DynamicResource L_Main_Refresh}">
                    <!-- 刷新图标：细描边圆弧 + 箭头，与项目内其他图标（描边风格）一致 -->
                    <Path x:Name="RefreshIcon" Width="15" Height="15" Stretch="Uniform"
                        Stroke="{DynamicResource TextBody}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        RenderTransformOrigin="0.5,0.5"
                        Data="M23,4 L23,10 L17,10 M20.49,15 A9,9 0 1 1 18.37,5.64 L23,10" />
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryBtn}" Content="{DynamicResource L_Main_Import}" Click="BtnAddFiles_Click"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="{DynamicResource L_Main_AddAll}" Click="BtnAddAll_Click"/>
                    <Button Style="{StaticResource ToolbarBtn}" Content="{DynamicResource L_Main_RemoveAll}" Click="BtnRemoveAll_Click"/>
                    <Button Style="{StaticResource DangerBtn}" Content="{DynamicResource L_Main_DeleteAll}" Click="BtnDeleteAll_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 列表区：贴边铺满，去掉四周 16px 外边距（与标题栏/工具栏同宽） -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}">
            <ListView Name="LvPrograms" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextBody}"
                          MouseDoubleClick="LvPrograms_MouseDoubleClick"
                          GridViewColumnHeader.Click="ColHeader_Click"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}"/>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="ColOp" Header="{DynamicResource L_Main_ColOp}" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 添加/移除指令互斥：按状态只显示其中一个 -->
                                            <Button Style="{StaticResource RowBtn}" Content="{DynamicResource L_Main_Detail}"
                                                    Click="BtnDetail_Click" Tag="{Binding}"/>
                                            <Button Style="{StaticResource PrimaryRowBtn}" Content="{DynamicResource L_Main_AddCmd}"
                                                    Click="BtnAddOne_Click" Tag="{Binding}"
                                                    IsEnabled="{Binding CanAdd}"
                                                    Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource RowBtn}" Content="{DynamicResource L_Main_RemoveCmd}"
                                                    Click="BtnRemoveOne_Click" Tag="{Binding}"
                                                    IsEnabled="{Binding CanRemove}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColStatus" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding StatusBg}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColDisplay" Header="{DynamicResource L_Main_ColDisplay}" Width="Auto" DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn x:Name="ColArch" Header="{DynamicResource L_Main_ColArch}" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Architecture}"
                                                   Foreground="{Binding ArchitectureFg}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColPath" Header="{DynamicResource L_Main_ColPath}" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OriginalTarget}" MaxWidth="420"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding OriginalTarget}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock Name="StatusText" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock Name="CleanupText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
