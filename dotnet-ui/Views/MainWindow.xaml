<Window x:Class="PathwinderMgt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pathwinder 管理器" Height="680" Width="1000" MinWidth="1000" MinHeight="680"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBg}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Pathwinder 管理器" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="导入 .lnk 快捷方式或 .exe，即可添加 Pathwinder 重定向能力"
                               Foreground="{DynamicResource TextMuted}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarBtn}" Content="当前权限：管理员" Click="BtnRunAsAdmin_Click" x:Name="BtnRunAsAdmin"/>
                    <Button Style="{StaticResource ToolbarBtn}" Content="说明" Click="BtnAbout_Click"/>
                    <Button Style="{StaticResource ToolbarBtn}" Content="设置" Click="BtnSettings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Style="{StaticResource ToolbarBtn}" Click="BtnRefresh_Click"
                    Padding="8,6" ToolTip="刷新列表" AutomationProperties.Name="刷新">
                    <!-- 刷新图标：细描边圆弧 + 箭头，与项目内其他图标（描边风格）一致 -->
                    <Path x:Name="RefreshIcon" Width="15" Height="15" Stretch="Uniform"
                        Stroke="{DynamicResource TextBody}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        RenderTransformOrigin="0.5,0.5"
                        Data="M23,4 L23,10 L17,10 M20.49,15 A9,9 0 1 1 18.37,5.64 L23,10" />
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryBtn}" Content="浏览" Click="BtnAddFiles_Click"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="全部添加" Click="BtnAddAll_Click"/>
                    <Button Style="{StaticResource ToolbarBtn}" Content="全部移除" Click="BtnRemoveAll_Click"/>
                    <Button Style="{StaticResource DangerBtn}" Content="全部删除" Click="BtnDeleteAll_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 列表区：贴边铺满，去掉四周 16px 外边距（与标题栏/工具栏同宽） -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}">
            <ListView Name="LvPrograms" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextBody}"
                          MouseDoubleClick="LvPrograms_MouseDoubleClick"
                          GridViewColumnHeader.Click="ColHeader_Click"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}"/>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="ColOp" Header="操作" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 添加/移除指令互斥：按状态只显示其中一个 -->
                                            <Button Style="{StaticResource RowBtn}" Content="详情"
                                                    Click="BtnDetail_Click" Tag="{Binding}"/>
                                            <Button Style="{StaticResource PrimaryRowBtn}" Content="添加指令"
                                                    Click="BtnAddOne_Click" Tag="{Binding}"
                                                    IsEnabled="{Binding CanAdd}"
                                                    Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource RowBtn}" Content="移除指令"
                                                    Click="BtnRemoveOne_Click" Tag="{Binding}"
                                                    IsEnabled="{Binding CanRemove}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColStatus" Header="状态" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding StatusBg}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColDisplay" Header="显示名" Width="Auto" DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn x:Name="ColArch" Header="架构" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Architecture}"
                                                   Foreground="{Binding ArchitectureFg}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColPath" Header="原 exe 路径" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OriginalTarget}" MaxWidth="420"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding OriginalTarget}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock Name="StatusText" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock Name="CleanupText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
