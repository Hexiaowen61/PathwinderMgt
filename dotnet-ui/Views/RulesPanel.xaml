<UserControl x:Class="PathwinderMgt.Views.RulesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei" FontSize="13">
    <Grid Background="{DynamicResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryBtn}" Content="{DynamicResource L_Rules_Add}" Name="BtnAdd" Click="BtnAdd_Click"/>
                <Button Style="{StaticResource ToolbarBtn}" Content="{DynamicResource L_Rules_Delete}" Name="BtnDel" Click="BtnDel_Click"/>
            </StackPanel>
        </Border>

        <!-- 规则列表 -->
        <Border Grid.Row="1" Margin="12,10" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <ListView Name="LvRules" Background="Transparent" BorderThickness="0"
                      SelectionMode="Single" SelectionChanged="LvRules_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}">
                        <Setter Property="Padding" Value="10,7"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource L_Rules_ColName}" Width="Auto" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="{DynamicResource L_Rules_ColOrigin}" Width="Auto" DisplayMemberBinding="{Binding OriginDirectory}"/>
                        <GridViewColumn Header="{DynamicResource L_Rules_ColTarget}" Width="Auto" DisplayMemberBinding="{Binding TargetDirectory}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 编辑区 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L_Rules_Name}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <!-- 规则名缩短，右侧放规则级模式下拉（仅“自定义”状态下可编辑） -->
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Name="TxtName"
                             Style="{StaticResource InputBox}"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource L_Rules_Mode}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <ComboBox Grid.Column="2" Name="CmbRuleMode"
                              Style="{StaticResource ComboBoxBox}"
                              ToolTip="{DynamicResource L_Rules_ModeTip}">
                        <ComboBoxItem Content="Simple"/>
                        <ComboBoxItem Content="SimplePro"/>
                        <ComboBoxItem Content="Overlay"/>
                    </ComboBox>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L_Rules_Origin}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtOrigin"
                         Style="{StaticResource InputBox}" Margin="0,0,0,6"
                         TextChanged="TxtOrigin_TextChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L_Rules_Target}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="TxtTarget"
                         Style="{StaticResource InputBox}"/>

                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Style="{StaticResource PrimaryBtn}" Content="{DynamicResource L_Rules_Save}" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
