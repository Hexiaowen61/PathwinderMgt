<UserControl x:Class="PathwinderMgt.Views.RulesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei" FontSize="13">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryBtn}" Content="新建规则" Name="BtnAdd" Click="BtnAdd_Click"/>
                <Button Style="{StaticResource ToolbarBtn}" Content="删除选中" Name="BtnDel" Click="BtnDel_Click"/>
            </StackPanel>
        </Border>

        <!-- 规则列表 -->
        <Border Grid.Row="1" Margin="12,10" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <ListView Name="LvRules" Background="Transparent" BorderThickness="0"
                      SelectionMode="Single" SelectionChanged="LvRules_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F2F4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="规则名" Width="Auto" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="原始路径" Width="Auto" DisplayMemberBinding="{Binding OriginDirectory}"/>
                        <GridViewColumn Header="目标路径" Width="Auto" DisplayMemberBinding="{Binding TargetDirectory}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 编辑区 -->
        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="规则名" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="TxtName" Padding="6,4" Margin="0,0,0,6" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="原始路径" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtOrigin" Padding="6,4" Margin="0,0,0,6" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="目标路径" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="TxtTarget" Padding="6,4" VerticalAlignment="Center"/>

                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Style="{StaticResource PrimaryBtn}" Content="保存" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
