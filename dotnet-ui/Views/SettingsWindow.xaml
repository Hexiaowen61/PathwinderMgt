<Window x:Class="PathwinderMgt.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource L_Settings_Title}" Height="620" Width="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="{DynamicResource WindowBg}"
    Foreground="{DynamicResource TextBody}"
    FontFamily="Microsoft YaHei" FontSize="13">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 语言：简体中文 / English -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Settings_Language}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="{DynamicResource L_Settings_LanguageDesc}" />
                        <Button x:Name="BtnLanguage" Style="{StaticResource ToolbarBtn}"
                            HorizontalAlignment="Left" Click="BtnLanguage_Click" />
                    </StackPanel>
                </Border>

                <!-- 外观：浅色 / 深色主题 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Settings_Appearance}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="{DynamicResource L_Settings_AppearanceDesc}" />
                        <Button x:Name="BtnTheme" Style="{StaticResource ToolbarBtn}"
                            HorizontalAlignment="Left" Click="BtnTheme_Click" />
                    </StackPanel>
                </Border>

                <!-- 全局默认路径设置（内置规则的源目录，新登记程序默认使用） -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Settings_GlobalOrigin}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="{DynamicResource L_Settings_GlobalOriginDesc}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="GlobalOriginBox"
                                Style="{StaticResource InputBox}"
                                IsReadOnly="True"
                                Background="{DynamicResource SurfaceAlt}"
                                ToolTip="{DynamicResource L_Settings_GlobalOriginTip}"/>
                            <Button Grid.Column="1" Content="{DynamicResource L_Common_Browse}" Style="{StaticResource ToolbarBtn}"
                                Margin="8,0,0,0" Click="BtnBrowseGlobalOrigin_Click"/>
                            <Button Grid.Column="2" Content="{DynamicResource L_Settings_RestoreDefault}" Style="{StaticResource ToolbarBtn}"
                                Margin="8,0,0,0" Click="BtnCancelGlobalOrigin_Click"/>
                        </Grid>
                        <!-- 仅在有提示信息时显示，避免卡片底部留下空白 -->
                        <TextBlock Name="TxtGlobalOriginHint" TextWrapping="Wrap" FontSize="12"
                            LineHeight="18" Margin="0,6,0,0" Foreground="{DynamicResource Success}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 快捷方式前缀设置 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Settings_Prefix}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource L_Settings_PrefixLabel}" Foreground="{DynamicResource TextSecondary}"
                                VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Name="PrefixBox" MaxLength="4" Width="120"
                                Style="{StaticResource InputBox}" />
                            <TextBlock Name="PrefixPreview" Foreground="{DynamicResource TextMuted}"
                                VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,8,0,0"
                            Text="{DynamicResource L_Settings_PrefixDesc}" />
                    </StackPanel>
                </Border>

                <!-- 快捷方式恢复（独立工具） -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Settings_RestoreTool}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="{DynamicResource L_Settings_RestoreDesc}" />
                        <Button Content="{DynamicResource L_Settings_OpenRestore}" Style="{StaticResource ToolbarBtn}"
                            HorizontalAlignment="Left" Click="BtnRestoreShortcut_Click"/>
                    </StackPanel>
                </Border>

                <!-- 运行库提示 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Settings_Runtime}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="{DynamicResource L_Settings_RuntimeDesc}" />
                        <CheckBox Name="ChkSuppressVcRuntime" Content="{DynamicResource L_Settings_SuppressRuntime}"
                            Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
            HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource L_Common_Cancel}" Click="CancelButton_Click" Style="{StaticResource ToolbarBtn}" />
            <Button x:Name="BtnSave" Content="{DynamicResource L_Common_Save}" Click="OkButton_Click"
                Style="{StaticResource PrimaryBtn}" IsEnabled="False"
                ToolTip="{DynamicResource L_Settings_SaveTip}" />
        </StackPanel>
    </Grid>
</Window>
