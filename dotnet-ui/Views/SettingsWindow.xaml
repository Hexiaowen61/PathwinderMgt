<Window x:Class="PathwinderMgt.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置" Height="560" Width="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="{DynamicResource WindowBg}"
    Foreground="{DynamicResource TextBody}"
    FontFamily="Microsoft YaHei" FontSize="13">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 外观：浅色 / 深色主题 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="切换管理器的深色 / 浅色主题，点击后立即生效。点「保存」保存选择；点「取消」恢复为打开设置前的主题。" />
                        <Button x:Name="BtnTheme" Style="{StaticResource ToolbarBtn}"
                            Content="当前主题：浅色" Click="BtnTheme_Click"
                            ToolTip="点击切换深色 / 浅色主题"/>
                    </StackPanel>
                </Border>

                <!-- 全局默认路径设置（内置规则的源目录，新登记程序默认使用） -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="全局默认路径" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="新登记程序的默认重定向源目录（初始值 C:\Users）。已登记程序的私有规则不受影响；选中目录后不会立即生效，点下方「保存」才写入配置并生效，重启后保持。点击右侧「浏览...」按钮选择目录。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="GlobalOriginBox"
                                Style="{StaticResource InputBox}"
                                IsReadOnly="True"
                                Background="{DynamicResource SurfaceAlt}"
                                ToolTip="全局默认路径（点击右侧浏览按钮选择目录）"/>
                            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource ToolbarBtn}"
                                Margin="8,0,0,0" Click="BtnBrowseGlobalOrigin_Click"/>
                            <Button Grid.Column="2" Content="恢复默认" Style="{StaticResource ToolbarBtn}"
                                Margin="8,0,0,0" Click="BtnCancelGlobalOrigin_Click"/>
                        </Grid>
                        <!-- 仅在有提示信息时显示，避免卡片底部留下空白 -->
                        <TextBlock Name="TxtGlobalOriginHint" TextWrapping="Wrap" FontSize="12"
                            LineHeight="18" Margin="0,6,0,0" Foreground="{DynamicResource Success}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 快捷方式前缀设置 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="快捷方式前缀" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="前缀" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                Margin="0,0,8,0" />
                            <TextBox Name="PrefixBox" MaxLength="4" Width="120"
                                Style="{StaticResource InputBox}" />
                            <TextBlock Name="PrefixPreview" Foreground="{DynamicResource TextMuted}"
                                VerticalAlignment="Center" Margin="16,0,0,0"
                                Text="预览：● 微信" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,8,0,0"
                            Text="最长 4 字符，不可包含文件系统非法符号（&lt; &gt; : &quot; / \ | ? *）。留空恢复默认 ●" />
                    </StackPanel>
                </Border>

                <!-- 快捷方式恢复（独立工具） -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="快捷方式恢复" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="在打开的窗口中拖入带前缀的受管快捷方式，自动还原为普通快捷方式输出到桌面，并删除原文件。独立工具，不影响主列表与程序配置；失败原因会显示在窗口日志中。" />
                        <Button Content="打开恢复窗口" Style="{StaticResource ToolbarBtn}"
                            HorizontalAlignment="Left" Click="BtnRestoreShortcut_Click"/>
                    </StackPanel>
                </Border>

                <!-- 运行库提示 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="运行库提示" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12"
                            LineHeight="18" Margin="0,0,0,8"
                            Text="Pathwinder 依赖 Microsoft Visual C++ 2015-2022 运行库（x64 / x86）。缺少时启动会弹窗提示并提供官方下载地址；勾选下方选项可不再提示。" />
                        <CheckBox Name="ChkSuppressVcRuntime" Content="启动时不再提示缺少运行库"
                            Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
            HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Click="CancelButton_Click" Style="{StaticResource ToolbarBtn}" />
            <Button x:Name="BtnSave" Content="保存" Click="OkButton_Click"
                Style="{StaticResource PrimaryBtn}" IsEnabled="False"
                ToolTip="设置项没有改动时不可保存" />
        </StackPanel>
    </Grid>
</Window>
