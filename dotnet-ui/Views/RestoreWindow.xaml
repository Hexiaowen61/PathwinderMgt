<Window x:Class="PathwinderMgt.Views.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_Restore_Title}" Height="400" Width="560" MinWidth="460" MinHeight="300"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei" FontSize="13"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource L_Restore_Hint}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" Name="LogBox" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource TextBody}"
                 Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" Padding="8"
                 VerticalContentAlignment="Top"/>
    </Grid>
</Window>
